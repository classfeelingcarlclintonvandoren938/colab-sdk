# Colab Client environment configuration
#
# Copy this file to .env and adjust paths for your setup.
# Required when google-colab-cli is installed in a non-standard location
# (e.g., inside WSL where scripts go to ~/.local/bin).

# Directory containing the `colab` CLI binary.
# Typical locations:
#   WSL (pip install --user):  /home/<user>/.local/bin
#   Linux (pip install --user): /home/<user>/.local/bin
#   Linux (pip install sudo):   /usr/local/bin
COLAB_BIN_DIR=/home/devjz/.local/bin
